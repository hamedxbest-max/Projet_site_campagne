# Exemple de fichier d'environnement pour le backend Django.
# Copier vers backend/.env et adapter. Ne jamais committer backend/.env.

DJANGO_SECRET_KEY=une-cle-tres-longue-et-secrete-a-remplacer
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données PostgreSQL ---
# En LOCAL : utilisez les variables DB_* ci-dessous (PostgreSQL installé localement).
# En PRODUCTION (Render) : utilisez uniquement DATABASE_URL (injecté par Render).
# Ne copiez PAS le DATABASE_URL de Render dans votre .env local.

DB_NAME=bouano_doumaintang
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Origines autorisées pour CORS (frontend local + Vercel)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://projet-site-campagne-git-main-xtech1.vercel.app

# Taramoney / paiement mobile
TARAMONEY_API_KEY=ta-cle-taramoney
TARAMONEY_BUSINESS_ID=ton-business-id
TARAMONEY_BASE_URL=https://www.dklo.co/api/tara/mobilepay
TARAMONEY_DEFAULT_WEBHOOK=https://projet-site-campagne.onrender.com/api/webhook/taramoney/

# Campay (legacy, optionnel)
CAMPAY_BASE_URL=https://demo.campay.net/api
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_WEBHOOK_KEY=

# Paramètres de campagne
MINIMUM_CONTRIBUTION_AMOUNT=20000
FUNDRAISING_GOAL=5000000
