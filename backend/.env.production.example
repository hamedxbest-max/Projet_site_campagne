# Variables à définir sur RENDER → Web Service → Environment (pas dans backend/.env)

DJANGO_SECRET_KEY=une-cle-tres-longue-et-secrete
DEBUG=False
ALLOWED_HOSTS=projet-site-campagne.onrender.com

# Lier la base bouano-db au service web (Link Database) — Render injecte DATABASE_URL
# Si mot de passe avec @ ou #, copier l'URL depuis Connect (déjà encodée)
DATABASE_URL=postgresql://bouano_db_user:XXXX@dpg-xxxxx-a.oregon-postgres.render.com/bouano_db

USE_SQLITE=False

CORS_ALLOWED_ORIGINS=https://projet-site-campagne.vercel.app,https://projet-site-campagne-git-main-xtech1.vercel.app

TARAMONEY_API_KEY=
TARAMONEY_BUSINESS_ID=
TARAMONEY_BASE_URL=https://www.dklo.co/api/tara/mobilepay
TARAMONEY_DEFAULT_WEBHOOK=https://projet-site-campagne.onrender.com/api/webhook/taramoney/

MINIMUM_CONTRIBUTION_AMOUNT=20000
FUNDRAISING_GOAL=5000000
