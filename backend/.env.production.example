# Exemple de fichier d'environnement pour le backend Django en production.
# Ne jamais committer le fichier réel `backend/.env` avec des valeurs secrètes.

DJANGO_SECRET_KEY=une-cle-tres-longue-et-secrete-a-remplacer
DEBUG=False
ALLOWED_HOSTS=backend-monapp.up.railway.app,localhost

# Si vous utilisez Supabase ou Railway Postgres en production,
# utilisez DATABASE_URL plutôt que les variables PostgreSQL séparées.
DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/nom_de_base

# fallback si vous ne souhaitez pas utiliser DATABASE_URL
USE_SQLITE=False
DB_NAME=bouano_doumaintang
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Origines autorisées pour CORS (frontend en local ou production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://votredomaine.cm

# Taramoney / paiement mobile
TARAMONEY_API_KEY=ta-cle-taramoney
TARAMONEY_BUSINESS_ID=ton-business-id
TARAMONEY_BASE_URL=https://www.dklo.co/api/tara/mobilepay
TARAMONEY_DEFAULT_WEBHOOK=https://backend-monapp.up.railway.app/api/payments/taramoney/webhook/

# Stockage média externe (optionnel)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# SUPABASE_URL=https://xyz.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=super-secret-key

# URL du backend utilisée par le frontend
VITE_API_BASE_URL=https://backend-monapp.up.railway.app/api

# Paramètres de campagne
MINIMUM_CONTRIBUTION_AMOUNT=20000
FUNDRAISING_GOAL=5000000
